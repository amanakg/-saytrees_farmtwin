# Server Configuration
PORT=3000
BASE_URL=http://localhost:3000

# JWT Configuration
ACCESS_TOKEN_SECRET=your_access_token_secret_key_here
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=your_refresh_token_secret_key_here
REFRESH_TOKEN_EXPIRES_IN=30d

# ─────────────────────────────────────────────────────────────
# CSV Database Storage Configuration
# Set STORAGE_TYPE to "local" (project folder) or "s3" (AWS S3)
# ─────────────────────────────────────────────────────────────
STORAGE_TYPE=local

# Optional: Custom local directory path for CSV files (defaults to ./src/data)
# CSV_LOCAL_DIR=./src/data

# ─────────────────────────────────────────────────────────────
# AWS S3 Settings (Required only when STORAGE_TYPE=s3)
# ─────────────────────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_S3_BUCKET=your-s3-bucket-name
AWS_S3_PREFIX=data/
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
# Optional cache TTL in ms for S3 reads (default: 5000ms for s3, 0 for local)
CSV_CACHE_TTL_MS=5000
